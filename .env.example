# Copie para .env e preencha. O .env real é gitignored.

# --- Chaves de acesso --------------------------------------------------------
# Gere cada uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# WRITE fica nas máquinas de captura. READ é a única que se entrega a quem só lê.
# Sempre entre aspas: scripts/backup.sh faz `source .env`, e valor com
# espaço sem aspas quebra o shell.
API_KEY_WRITE="troque-me-chave-de-escrita"
API_KEY_READ="troque-me-chave-de-leitura"

# --- Postgres (Neon) ---------------------------------------------------------
# Connection Details no dashboard do projeto.
# DATABASE_URL      -> branch `main`  (produção, o que o consumidor externo lê)
# DATABASE_URL_TEST -> branch `test`  (os testes dão TRUNCATE nesta; nunca aponte
#                                      para a de produção ou eles apagam os dados)
DATABASE_URL="postgresql://user:senha@ep-xxx.us-west-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_TEST="postgresql://user:senha@ep-xxx.us-west-2.aws.neon.tech/neondb_test?sslmode=require"

# --- Estação de captura (medir_grama.py) -------------------------------------
API_URL="http://localhost:8000"

# REGIAO identifica ESTA máquina. A fonte de verdade é calibration.json
# (preenchida no `python calibrar.py`); esta variável fica como fallback pra
# estações antigas que ainda não foram recalibradas. Se calibrar.py já rodou
# depois desta mudança, pode apagar esta linha.
REGIAO="mato do matheus"

# --- Câmera (opcional) -------------------------------------------------------
# Detectado sozinho: CAP_MSMF no Windows, CAP_V4L2 no Linux (Raspberry Pi).
# Só preencha se a detecção automática não servir — câmera CSI, driver
# diferente, ou mais de uma câmera na máquina.
# CAMERA_BACKEND="CAP_V4L2"
# CAMERA_INDEX="0"
